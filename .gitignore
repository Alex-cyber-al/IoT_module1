sitemap apartment label "Розумна Квартира (Варіант 1)" {
    Frame label="Енергомоніторинг (Головний лічильник)" {
        Text item=Apartment_Power label="Поточне споживання [%.1f W]" icon="energy"
        
        // Графік споживання енергії за останню годину
        Chart item=Apartment_Power period=h refresh=5000 legend=true
    }

    Frame label="Кліматконтроль" {
        Text item=Corridor_Temp label="Температура коридор [%.1f °C]" icon="temperature"
        Text item=Corridor_Humid label="Вологість коридор [%.1f %%]" icon="humidity"
    }

    Frame label="Безпека та Рух" {
        Text item=Room1_Motion label="Кімната 1 [%s]" icon="motion"
        Text item=Room2_Motion label="Кімната 2 [%s]" icon="motion"
    }
}
